EXPO_PUBLIC_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
EXPO_PUBLIC_GITHUB_SCOPE=repo

# For local development, point to the Express server
EXPO_PUBLIC_API_URL=http://localhost:3000

# TypeSafe — structured issue triage (optional, server-side only)
# Without it the app runs normally and the TRIAGE button stays hidden.
# Get a key at https://typesafe.ai — never commit the real value.
TYPESAFE_API_KEY=your_typesafe_api_key

# Azure Cosmos DB — session storage (optional, falls back to in-memory)
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your_cosmos_primary_key
COSMOS_DATABASE=issuecrush
COSMOS_CONTAINER=sessions
